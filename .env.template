# OpenTransAgent 配置
# 复制此文件为 .env 并填入你的密钥

LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=120
MAX_ITERATIONS=120

# 拓扑排序脚本路径
# 用于按文件依赖分析翻译顺序（加速编译通过率）
# 需要额外 clone: https://github.com/your-org/file_topo_sort
# 例如：TOPO_SORT_PATH=D:\Code2Graph\file_topo_sort\topo_sort_files.py
TOPO_SORT_PATH=

# 编译工具链路径（分号分隔）
# 只有工具未在系统 PATH 中时才需要配置，正常安装可留空
# 例如：TOOLCHAIN_PATHS=C:\tools\mingw64\bin;C:\Program Files\CMake\bin
TOOLCHAIN_PATHS=

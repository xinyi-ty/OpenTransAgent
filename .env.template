# OpenTransAgent 配置
# 复制此文件为 .env 并填入你的密钥

# ── LLM 配置 ─────────────────────────────────────────────
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=120

# ── 翻译循环配置 ─────────────────────────────────────────
# MAX_ITERATIONS: 每层最大外循环轮数
# STEPS_PER_ROUND: 每轮 Conversation.run 最多执行的 SDK Agent step 数
MAX_ITERATIONS=120
STEPS_PER_ROUND=50
ROUND_TIMEOUT=1800
INVALID_RESPONSE_LIMIT=3
RUNTIME_ERROR_LIMIT=3
COMPLETENESS_RETRY_LIMIT=3
REFLECTION_ENABLED=1

# ── 工具配置 ─────────────────────────────────────────────
TOOL_COMMAND_TIMEOUT=60
SEARCH_MAX_RESULTS=10

# ── 测试反馈配置 ─────────────────────────────────────────
TEST_TIMEOUT=300
# 反馈给 LLM 的测试原始输出上限；0 表示不截断
TEST_RAW_OUTPUT_LIMIT=5000

# ── 功能调用追踪日志 ─────────────────────────────────────
# 生成 logs/<model>/<project>.../translation_trace.jsonl，用于排查 LLM 空转/工具调用问题
TRACE_LOG_ENABLED=1
TRACE_LOG_MAX_FIELD_CHARS=20000
TRACE_LOG_REDACT_SECRETS=1

# ── 拓扑排序脚本路径 ─────────────────────────────────────
# 用于按文件依赖分析翻译顺序（加速编译通过率）
# 可选依赖：https://github.com/Code2Graph/Code2Graph
# 例如：TOPO_SORT_PATH=D:\Code2Graph\file_topo_sort\topo_sort_files.py
TOPO_SORT_PATH=

# ── 编译工具链路径（分号分隔）────────────────────────────
# 只有工具未在系统 PATH 中时才需要配置，正常安装可留空
# 例如：TOOLCHAIN_PATHS=C:\tools\mingw64\bin;C:\Program Files\CMake\bin
TOOLCHAIN_PATHS=

# ═══════════════════════════════════════════════════════════════
# 非默认调优建议（以下不是程序默认值；按需复制并覆盖上面的活动配置）
# 判断规模时优先看“待翻译源文件数”，同时考虑依赖层数、最大单文件和测试耗时。
#
# 小型仓库（<=20 个源文件；复杂核心文件建议 STEPS_PER_ROUND=50）
# MAX_ITERATIONS=20
# STEPS_PER_ROUND=40
# ROUND_TIMEOUT=900
# SEARCH_MAX_RESULTS=10
# TEST_TIMEOUT=300
#
# 中型仓库（21-100 个源文件）
# MAX_ITERATIONS=40
# STEPS_PER_ROUND=30
# ROUND_TIMEOUT=1800
# SEARCH_MAX_RESULTS=20
# TEST_TIMEOUT=600
#
# 大型仓库（>100 个源文件）
# MAX_ITERATIONS=80
# STEPS_PER_ROUND=30
# ROUND_TIMEOUT=3600
# SEARCH_MAX_RESULTS=30
# TEST_TIMEOUT=1200
#
# 模型直联 / 低延迟接口
# LLM_TIMEOUT=120
# RUNTIME_ERROR_LIMIT=3
#
# 模型中转 / 高延迟 / 慢推理接口（例如本项目使用的 qwen 中转站）
# LLM_TIMEOUT=300
# RUNTIME_ERROR_LIMIT=5
# 极慢链路可把 LLM_TIMEOUT 提高到 600。
# ROUND_TIMEOUT 是完整 Conversation.run() 一轮的上限，LLM_TIMEOUT 是单次模型调用上限；
# ROUND_TIMEOUT 应显著大于 LLM_TIMEOUT，并至少采用上面的仓库规模建议值。
#
# 编译型或慢测试项目可额外使用：
# TOOL_COMMAND_TIMEOUT=120
# TEST_TIMEOUT=600
#
# COMPLETENESS_RETRY_LIMIT / INVALID_RESPONSE_LIMIT 建议保持 3；
# REFLECTION_ENABLED / TRACE_LOG_ENABLED / TRACE_LOG_REDACT_SECRETS 建议保持开启。
